{
	"name": "maut-claude-images",
	"displayName": "Maut Claude Images",
	"description": "Sidebar gallery and terminal link integration for Claude Code image cache",
	"version": "1.0.0",
	"publisher": "maut",
	"license": "MIT",
	"engines": {
		"vscode": "^1.121.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"devDependencies": {
		"@types/node": "22.x"
	},
	"contributes": {
		"commands": [
			{
				"command": "maut.chat.startClaude",
				"title": "Spawn New Maut Claude (clsp)",
				"category": "Maut",
				"icon": "$(flame)"
			},
			{
				"command": "maut.terminals.switch",
				"title": "Switch Maut Terminal",
				"category": "Maut",
				"icon": "$(list-tree)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "maut.terminals.switch",
					"group": "navigation@3"
				}
			],
			"view/title": [
				{
					"command": "maut.chat.startClaude",
					"when": "view == terminal",
					"group": "navigation@1"
				},
				{
					"command": "maut.terminals.switch",
					"when": "view == terminal",
					"group": "navigation@98"
				}
			]
		},
		"configuration": {
			"title": "Maut",
			"properties": {
				"maut.autoLaunchClsp": {
					"type": "boolean",
					"default": true,
					"description": "On Maut code launch, automatically spawn a new clsp terminal if no Maut Claude session is already running."
				},
				"maut.autoEnterFocusMode": {
					"type": "boolean",
					"default": false,
					"description": "After auto-launching clsp on app open, also enter Maut Focus Mode (zen-style)."
				},
				"maut.autoResumeOnLaunch": {
					"type": "boolean",
					"default": true,
					"description": "After auto-launching clsp on app open, type `/resume` + Enter ~2s later to restore the last Claude conversation."
				}
			}
		}
	}
}
