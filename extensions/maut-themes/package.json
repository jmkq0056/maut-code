{
	"name": "maut-themes",
	"displayName": "Maut Theme Studio",
	"description": "Visual theme + font customiser with live preview, presets, save/load. Includes a polished light mode.",
	"version": "1.1.0",
	"publisher": "maut",
	"license": "MIT",
	"engines": { "vscode": "^1.121.0" },
	"main": "./out/extension",
	"activationEvents": [ "onStartupFinished" ],
	"capabilities": {
		"untrustedWorkspaces": { "supported": true },
		"virtualWorkspaces": true
	},
	"devDependencies": { "@types/node": "22.x" },
	"contributes": {
		"commands": [
			{ "command": "maut.theme.toggle", "title": "Toggle Maut Light / Dark", "category": "Maut", "icon": "$(color-mode)" },
			{ "command": "maut.theme.studio", "title": "Open Theme Studio", "category": "Maut", "icon": "$(symbol-color)" }
		],
		"keybindings": [
			{ "command": "maut.theme.toggle", "key": "cmd+shift+l", "mac": "cmd+shift+l" },
			{ "command": "maut.theme.studio", "key": "cmd+shift+t", "mac": "cmd+shift+t" }
		],
		"menus": {
			"editor/title": [
				{ "command": "maut.theme.toggle", "group": "navigation@5" }
			]
		}
	}
}
