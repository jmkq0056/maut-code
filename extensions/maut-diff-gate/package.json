{
	"name": "maut-diff-gate",
	"displayName": "Maut Diff Gate",
	"description": "Intercept Claude Code Write/Edit tool calls and show a Maut diff preview before applying — works even with --dangerously-skip-permissions.",
	"version": "1.0.0",
	"publisher": "maut",
	"license": "MIT",
	"engines": {
		"vscode": "^1.121.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": { "supported": true },
		"virtualWorkspaces": false
	},
	"devDependencies": {
		"@types/node": "22.x"
	},
	"contributes": {
		"commands": [
			{
				"command": "maut.diffGate.toggle",
				"title": "Toggle Diff Gate",
				"category": "Maut"
			},
			{
				"command": "maut.diffGate.installHook",
				"title": "Install Claude Code Hook",
				"category": "Maut"
			}
		],
		"configuration": {
			"title": "Maut Diff Gate",
			"properties": {
				"maut.diffGate.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show a diff preview before Claude Code applies Write/Edit/MultiEdit tool calls."
				},
				"maut.diffGate.autoApproveSmallEdits": {
					"type": "boolean",
					"default": false,
					"description": "Auto-approve edits that change fewer than `maut.diffGate.smallEditThreshold` lines."
				},
				"maut.diffGate.smallEditThreshold": {
					"type": "number",
					"default": 5,
					"description": "Line-count threshold for `maut.diffGate.autoApproveSmallEdits`."
				}
			}
		}
	}
}
